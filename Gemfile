source "https://rubygems.org"

# Matches what GitHub Pages actually builds this site with (legacy build).
# Keeping this pinned means local preview == production.
gem "github-pages", "~> 232", group: :jekyll_plugins

group :jekyll_plugins do
  gem "jekyll-sitemap"
  gem "jekyll-feed"
  gem "jekyll-seo-tag"
  gem "jekyll-paginate"
end

# Ruby 3.4+ dropped these from the stdlib.
gem "csv"
gem "base64"
gem "bigdecimal"
gem "logger"
gem "ostruct"
